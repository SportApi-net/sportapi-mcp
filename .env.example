# Copy to .env (never commit it) or set these in your MCP client's "env" block.
# Without them the server runs in demo mode on example data from the SportAPI documentation.
SPORTAPI_KEY=YOUR_API_KEY
SPORTAPI_BASE_URL=https://YOUR_API_DOMAIN
# Optional, default "en". Must be a language enabled for your key.
SPORTAPI_LANGUAGE=en
